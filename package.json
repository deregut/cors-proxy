{
  "name": "cors-proxy",
  "version": "1.0.0",
  "description": "Minimal self-hostable CORS proxy with a web UI. Deploys to Netlify; also runs standalone via Node or Docker.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "netlify dev",
    "start": "node server.js",
    "deploy": "netlify deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "netlify": "^17.0.0"
  },
  "keywords": [
    "cors",
    "proxy",
    "netlify",
    "serverless",
    "docker"
  ],
  "license": "MIT"
}
