# Copy this file to `.env` (in the project root) and adjust values as needed.
#   cp .env.example .env
# `docker compose` automatically loads `.env` from the project directory, so the
# variables below become available to docker-compose.yml. `.env` holds your real
# values — do NOT commit it. It is excluded from the Docker image (see
# .dockerignore); also add `.env` to your .gitignore.

# --- Host side (used by docker-compose.yml) ---
# Host port to expose. The container port is fixed at 3000.
#   HOST_PORT=8080  ->  http://localhost:8080
HOST_PORT=3000

# --- Container side (passed into the running service) ---
# Port the Node server (server.js) listens on inside the container.
PORT=3000

# Runtime mode.
NODE_ENV=production

# --- Optional hardening (NOT yet enforced by the app) ---
# If you wire these into server.js / lib/proxy.js, define them here:
# PROXY_API_KEY=change-me            # require this on the `x-proxy-key` header
# PROXY_ALLOWED_HOSTS=api.github.com,httpbin.org  # comma-separated allowlist
# PROXY_MAX_BYTES=10485760           # response size cap (default 10 MB)
